# 由终端或应用启动器读取；服务不会自动加载 .env 文件。
# 不要提交真实 API 凭据。
OPENAI_API_KEY=
FVA_MODEL=
# 可选的 OpenAI 兼容服务地址，仅传给模型客户端。
# OPENAI_BASE_URL=https://api.openai.com/v1
FVA_DB_PATH=artifacts/tasks.sqlite3
# 快照与裸镜像缓存目录；需在部署环境中持久化。
FVA_STORAGE_DIR=storage
# 允许获取快照的代码托管主机，逗号分隔；默认 github.com。
# FVA_REPOSITORY_HOSTS=github.com
FVA_CONCURRENCY=2
FVA_MAX_MODEL_CALLS=16
FVA_MAX_TOOL_CALLS=32
FVA_TIMEOUT_SECONDS=120
FVA_MAX_OUTPUT_TOKENS=2048
FVA_TEMPERATURE=0
# 取得课程数据并建立历史索引后，设置以下版本信息。
# FVA_DATA_VERSION=
# FVA_INDEX_VERSION=
