# Read by your shell/application launcher; the service does not load .env automatically.
# Never commit actual API credentials.
OPENAI_API_KEY=
FVA_MODEL=
# Optional OpenAI-compatible provider endpoint, passed only to the model client.
# OPENAI_BASE_URL=https://api.openai.com/v1
FVA_DB_PATH=artifacts/tasks.sqlite3
FVA_CONCURRENCY=2
FVA_MAX_MODEL_CALLS=16
FVA_MAX_TOOL_CALLS=32
FVA_TIMEOUT_SECONDS=120
FVA_MAX_OUTPUT_TOKENS=2048
FVA_TEMPERATURE=0
# Set these when course data and the historical index are available.
# FVA_DATA_VERSION=
# FVA_INDEX_VERSION=
